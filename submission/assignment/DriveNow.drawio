        <mxCell id="e-ewUiryXzSy7Xtcp9-6-7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;PaymentMethod&lt;/div&gt;&lt;div&gt;NN&lt;/div&gt;" vertex="1">
